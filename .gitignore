# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# Secrets and local config
.env
.env.*
!.env.example

# Data and model artifacts (tracked by DVC, never by git)
# data/ contents are added with `dvc add`, which writes its own .gitignore entries
*.h5
*.h5ad
*.parquet
*.ckpt
*.pt
*.pth
mlruns/
mlartifacts/
wandb/

# Web
node_modules/
.next/

# OS / editor
.DS_Store
.idea/
.vscode/

mlflow.db
outputs/

# MkDocs build output
site/

# Raw/derived data never enters git (DVC); only placeholders and DVC pointer files are kept.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/raw/*.dvc
!data/interim/*.dvc
!data/processed/*.dvc
